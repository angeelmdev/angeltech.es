<div id="ajustes" class="tab-panel hidden">
    <div class="ps-10">
        <h2 class="pt-5 pb-10 text-3xl font-bold text-black">AJUSTES</h2>
        
        <div class="max-w-2xl mx-auto bg-white p-8 rounded-lg">
            <h3 class="text-xl font-semibold text-gray-900 mb-6">Credenciales de acceso</h3>
            
            <p class="text-sm text-gray-600 mb-6">
                Para realizar cambios en tu cuenta, debes introducir tu contraseña actual.
                Si deseas cambiar tu contraseña, introduce la nueva en los campos correspondientes.
                Si no deseas cambiarla, deja los campos de contraseña nueva vacíos.
            </p>
            
            {{ form_start(settingsForm, {'attr': {'class': 'space-y-4'}}) }}

                {{ form_row(settingsForm.currentPassword) }}
                {{ form_row(settingsForm.email) }}
                {{ form_row(settingsForm.plainPassword.first) }}
                {{ form_row(settingsForm.plainPassword.second) }}

                <div class="flex justify-end">
                    <button type="submit" class="w-40 text-white bg-blue-600 hover:bg-blue-700 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                        Guardar cambios
                    </button>
                </div>

            {{ form_end(settingsForm) }}
        </div>
    </div>
</div>
